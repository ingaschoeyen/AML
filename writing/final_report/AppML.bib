  shorttitle = {Open-{{Source OCR Libraries}}},
  booktitle = {Proceedings of the 21st {{International Conference}} on {{Natural Language Processing}} ({{ICON}})},
  author = {Nazeem, Meharuniza and R, Anitha and S, Navaneeth and R. R, Rajeev},
