@inproceedings{thoratDetailedReviewText2022,
  title = {A {{Detailed Review}} on {{Text Extraction Using Optical Character Recognition}}},
  booktitle = {{{ICT Analysis}} and {{Applications}}},
  author = {Thorat, Chhanam and Bhat, Aishwarya and Sawant, Padmaja and Bartakke, Isha and Shirsath, Swati},
